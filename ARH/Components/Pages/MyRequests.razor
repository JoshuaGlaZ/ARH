@page "/requests/my"
@using System.Security.Claims
@using ARH.Domain.Entities
@using ARH.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Requester")]

@inject AccessRequestService RequestService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Requests</PageTitle>

<h3>My Requests</h3>
<p class="text-muted">Track your submitted access requests.</p>

@if (requests == null)
{
    <p>Loading requests...</p>
}
else if (requests.Count == 0)
{
    <div class="alert alert-info">
        You have not submitted any access requests.
        <a href="/requests/create">Create your first request.</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Environment</th>
                    <th>Access</th>
                    <th>Risk</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in requests)
                {
                    <tr>
                        <td>@request.Application?.Name</td>
                        <td>@request.Environment</td>
                        <td>@request.AccessLevel</td>
                        <td>@request.RiskLevel</td>
                        <td>
                            <span class="badge bg-secondary">
                                @request.Status
                            </span>
                        </td>
                        <td>
                            @request.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")
                        </td>
                        <td>
                            <a href="@($"/requests/{request.Id}")"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AccessRequest>? requests;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var userId = authState.User.FindFirstValue(
            ClaimTypes.NameIdentifier);

        if (!Guid.TryParse(userId, out var requesterId))
        {
            requests = new();
            return;
        }

        requests = await RequestService.GetMyRequestsAsync(
            requesterId);
    }
}
