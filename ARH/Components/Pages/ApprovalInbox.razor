@page "/approvals"
@using System.Security.Claims
@using ARH.Domain.Entities
@using ARH.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Manager,SystemOwner")]

@inject AccessRequestService RequestService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Approval Inbox</PageTitle>

<h3>Approval Inbox</h3>
<p class="text-muted">Requests waiting for your approval.</p>

@if (requests == null)
{
    <p>Loading inbox...</p>
}
else if (requests.Count == 0)
{
    <div class="alert alert-info">
        No pending approvals.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Requester</th>
                    <th>Application</th>
                    <th>Environment</th>
                    <th>Access</th>
                    <th>Risk</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in requests)
                {
                    <tr>
                        <td>@request.Requester?.FullName</td>
                        <td>@request.Application?.Name</td>
                        <td>@request.Environment</td>
                        <td>@request.AccessLevel</td>
                        <td>@request.RiskLevel</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                @request.Status
                            </span>
                        </td>
                        <td>
                            <a href="@($"/requests/{request.Id}")"
                               class="btn btn-sm btn-primary">
                                Review
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AccessRequest>? requests;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var userId = authState.User.FindFirstValue(
            ClaimTypes.NameIdentifier);

        if (!Guid.TryParse(userId, out var actorId))
        {
            requests = new();
            return;
        }

        requests = await RequestService.GetInboxAsync(actorId);
    }
}
