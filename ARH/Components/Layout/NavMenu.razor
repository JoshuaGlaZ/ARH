@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar-brand">
    <a href="/" class="brand-link">
        <span class="brand-mark">A</span>
        <span>
            <strong>ARH</strong>
            <small>Access Request Hub</small>
        </span>
    </a>
</div>

<nav class="sidebar-nav">

    <div class="nav-section">WORKSPACE</div>

    <div class="nav-item">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <span>Dashboard</span>
        </NavLink>
    </div>

    <AuthorizeView Roles="Requester">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="/requests/create">
                    Create Request
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="/requests/my">
                    My Requests
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Manager,SystemOwner">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="/approvals">
                    Approval Inbox
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="AdminAuditor">
        <Authorized>
            <div class="nav-section mt-4">ADMINISTRATION</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="/admin/audit">
                    Audit Logs
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

</nav>
